DATABASE_URL="postgresql://restaurante:restaurante_dev@localhost:5432/restaurante"
REDIS_URL="redis://localhost:6379"

# JWT - ¡CAMBIAR EN PRODUCCIÓN!
JWT_SECRET="cambia-este-secreto-por-uno-seguro-de-al-menos-32-caracteres"
JWT_REFRESH_SECRET="otro-secreto-diferente-para-refresh-tokens-min-32-chars"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Servidor
PORT=3000

# Almacenamiento de Archivos
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=tu-key
# AWS_SECRET_ACCESS_KEY=tu-secret
# AWS_BUCKET=tu-bucket
# AWS_REGION=us-east-1

# Notificaciones por Email
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password

# SMS (Twilio) - Opcional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# URLs de Frontend
FRONTEND_POS_URL=http://localhost:3001
FRONTEND_QR_URL=http://localhost:3002
FRONTEND_LANDING_URL=http://localhost:3003

# Node Environment
NODE_ENV=development
