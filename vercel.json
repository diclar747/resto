{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate --schema=prisma/schema.prisma && cd apps/api && rm -rf dist tsconfig.tsbuildinfo && npx tsc -p tsconfig.json && cd ../.. && node deploy-vercel.js",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "api/nestjs-bundle.txt,api/node_modules/**,api/prisma/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/pos/(.*)", "destination": "/pos/index.html" },
    { "source": "/menu/(.*)", "destination": "/menu/index.html" },
    { "source": "/((?!api|pos|menu).*)", "destination": "/index.html" }
  ]
}
