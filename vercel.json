{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate && echo TSC_START && cd apps/api && npx tsc -p tsconfig.json && echo TSC_OK && cd ../.. && echo DEPLOY_START && node deploy-vercel.js && echo DEPLOY_OK",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "api/nestjs-bundle.txt,prisma/**,node_modules/.prisma/**,node_modules/@prisma/client/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/pos/(.*)", "destination": "/pos/index.html" },
    { "source": "/menu/(.*)", "destination": "/menu/index.html" },
    { "source": "/((?!api|pos|menu).*)", "destination": "/index.html" }
  ]
}
