generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MULTI-BRANCH
// ============================================================

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  timezone  String   @default("America/Argentina/Buenos_Aires")
  currency  String   @default("ARS")
  isActive  Boolean  @default(true)
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             UserBranch[]
  tables            Table[]
  categories        Category[]
  products          ProductBranch[]
  orders            Order[]
  cashRegisters     CashRegister[]
  stockItems        StockItem[]
  suppliers         SupplierBranch[]
  promotions        PromotionBranch[]
  kitchenStations   KitchenStation[]

  @@map("branches")
}

// ============================================================
// USERS & ROLES
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  pin          String?  @db.VarChar(6)
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branches           UserBranch[]
  ordersAsWaiter     Order[]        @relation("waiter")
  ordersAsCashier    Order[]        @relation("cashier")
  cashRegisters      CashRegister[] @relation("cashier")
  deliveriesAsDriver Delivery[]     @relation("driver")
  auditLogs          AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json
  createdAt   DateTime @default(now())

  userBranches UserBranch[]

  @@map("roles")
}

model UserBranch {
  id       String @id @default(cuid())
  userId   String
  branchId String
  roleId   String

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, branchId])
  @@map("user_branches")
}

// ============================================================
// MENU & PRODUCTS
// ============================================================

model Category {
  id          String    @id @default(cuid())
  branchId    String
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  parentId    String?

  branch   Branch     @relation(fields: [branchId], references: [id])
  parent   Category?  @relation("subcategories", fields: [parentId], references: [id])
  children Category[] @relation("subcategories")
  products Product[]

  @@map("categories")
}

model Product {
  id               String   @id @default(cuid())
  categoryId       String
  name             String
  description      String?
  imageUrl         String?
  sku              String?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  prepTime         Int?
  kitchenStationId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category       Category              @relation(fields: [categoryId], references: [id])
  kitchenStation KitchenStation?        @relation(fields: [kitchenStationId], references: [id])
  variants       ProductVariant[]
  modifierGroups ProductModifierGroup[]
  branches       ProductBranch[]
  recipeItems    RecipeItem[]
  comboItems     ComboItem[]

  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String
  price     Decimal @db.Decimal(10, 2)
  cost      Decimal? @db.Decimal(10, 2)
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@map("product_variants")
}

model ModifierGroup {
  id         String  @id @default(cuid())
  name       String
  minSelect  Int     @default(0)
  maxSelect  Int     @default(1)
  isRequired Boolean @default(false)

  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@map("modifier_groups")
}

model Modifier {
  id              String  @id @default(cuid())
  modifierGroupId String
  name            String
  priceAdjustment Decimal @default(0) @db.Decimal(10, 2)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  modifierGroup      ModifierGroup       @relation(fields: [modifierGroupId], references: [id])
  orderItemModifiers OrderItemModifier[]

  @@map("modifiers")
}

model ProductModifierGroup {
  productId       String
  modifierGroupId String

  product       Product       @relation(fields: [productId], references: [id])
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

model ProductBranch {
  id            String   @id @default(cuid())
  productId     String
  branchId      String
  isAvailable   Boolean  @default(true)
  priceOverride Decimal? @db.Decimal(10, 2)

  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId])
  @@map("product_branches")
}

// ============================================================
// COMBOS
// ============================================================

model Combo {
  id        String   @id @default(cuid())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items ComboItem[]

  @@map("combos")
}

model ComboItem {
  id        String @id @default(cuid())
  comboId   String
  productId String
  quantity  Int    @default(1)

  combo   Combo   @relation(fields: [comboId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("combo_items")
}

// ============================================================
// TABLES
// ============================================================

model Table {
  id       String  @id @default(cuid())
  branchId String
  number   Int
  name     String?
  zone     String?
  capacity Int     @default(4)
  status   String  @default("free")
  posX     Float?
  posY     Float?
  shape    String  @default("square")
  isActive Boolean @default(true)
  qrCode   String? @unique

  branch Branch  @relation(fields: [branchId], references: [id])
  orders Order[]

  @@unique([branchId, number])
  @@map("tables")
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id             String    @id @default(cuid())
  branchId       String
  orderNumber    Int
  type           String
  status         String    @default("open")
  tableId        String?
  waiterId       String?
  cashierId      String?
  clientId       String?
  guestCount     Int?
  notes          String?
  subtotal       Decimal   @db.Decimal(10, 2) @default(0)
  discountAmount Decimal   @db.Decimal(10, 2) @default(0)
  discountType   String?
  taxAmount      Decimal   @db.Decimal(10, 2) @default(0)
  tipAmount      Decimal   @db.Decimal(10, 2) @default(0)
  total          Decimal   @db.Decimal(10, 2) @default(0)
  promotionId    String?
  parentOrderId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  closedAt       DateTime?

  branch      Branch      @relation(fields: [branchId], references: [id])
  table       Table?      @relation(fields: [tableId], references: [id])
  waiter      User?       @relation("waiter", fields: [waiterId], references: [id])
  cashier     User?       @relation("cashier", fields: [cashierId], references: [id])
  client      Client?     @relation(fields: [clientId], references: [id])
  promotion   Promotion?  @relation(fields: [promotionId], references: [id])
  parentOrder Order?      @relation("orderSplits", fields: [parentOrderId], references: [id])
  childOrders Order[]     @relation("orderSplits")

  items      OrderItem[]
  payments   Payment[]
  tickets    Ticket[]
  kdsTickets KdsTicket[]
  delivery   Delivery?

  @@index([branchId, createdAt])
  @@index([branchId, status])
  @@map("orders")
}

model OrderItem {
  id               String    @id @default(cuid())
  orderId          String
  productVariantId String
  quantity         Int       @default(1)
  unitPrice        Decimal   @db.Decimal(10, 2)
  subtotal         Decimal   @db.Decimal(10, 2)
  notes            String?
  status           String    @default("pending")
  sentToKitchenAt  DateTime?
  prepStartedAt    DateTime?
  readyAt          DateTime?
  deliveredAt      DateTime?
  seat             Int?
  courseNumber      Int       @default(1)

  order          Order               @relation(fields: [orderId], references: [id])
  productVariant ProductVariant      @relation(fields: [productVariantId], references: [id])
  modifiers      OrderItemModifier[]
  kdsTicketItems KdsTicketItem[]

  @@map("order_items")
}

model OrderItemModifier {
  id              String  @id @default(cuid())
  orderItemId     String
  modifierId      String
  priceAdjustment Decimal @db.Decimal(10, 2) @default(0)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  @@map("order_item_modifiers")
}

// ============================================================
// KDS (Kitchen Display System)
// ============================================================

model KitchenStation {
  id       String  @id @default(cuid())
  branchId String
  name     String
  color    String?
  isActive Boolean @default(true)

  branch     Branch      @relation(fields: [branchId], references: [id])
  products   Product[]
  kdsTickets KdsTicket[]

  @@map("kitchen_stations")
}

model KdsTicket {
  id               String    @id @default(cuid())
  orderId          String
  kitchenStationId String
  status           String    @default("pending")
  priority         Int       @default(0)
  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  completedAt      DateTime?

  order          Order          @relation(fields: [orderId], references: [id])
  kitchenStation KitchenStation @relation(fields: [kitchenStationId], references: [id])
  items          KdsTicketItem[]

  @@index([kitchenStationId, status])
  @@map("kds_tickets")
}

model KdsTicketItem {
  id          String @id @default(cuid())
  kdsTicketId String
  orderItemId String

  kdsTicket KdsTicket @relation(fields: [kdsTicketId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@map("kds_ticket_items")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id             String   @id @default(cuid())
  orderId        String
  method         String
  amount         Decimal  @db.Decimal(10, 2)
  receivedAmount Decimal? @db.Decimal(10, 2)
  changeAmount   Decimal? @db.Decimal(10, 2)
  reference      String?
  status         String   @default("completed")
  createdAt      DateTime @default(now())

  order     Order                  @relation(fields: [orderId], references: [id])
  movements CashRegisterMovement[]

  @@map("payments")
}

// ============================================================
// CASH REGISTER
// ============================================================

model CashRegister {
  id             String    @id @default(cuid())
  branchId       String
  cashierId      String
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openingBalance Decimal   @db.Decimal(10, 2)
  closingBalance Decimal?  @db.Decimal(10, 2)
  actualBalance  Decimal?  @db.Decimal(10, 2)
  difference     Decimal?  @db.Decimal(10, 2)
  status         String    @default("open")
  notes          String?

  branch    Branch                 @relation(fields: [branchId], references: [id])
  cashier   User                   @relation("cashier", fields: [cashierId], references: [id])
  movements CashRegisterMovement[]

  @@map("cash_registers")
}

model CashRegisterMovement {
  id             String   @id @default(cuid())
  cashRegisterId String
  type           String
  amount         Decimal  @db.Decimal(10, 2)
  description    String?
  paymentId      String?
  createdAt      DateTime @default(now())

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  @@map("cash_register_movements")
}

// ============================================================
// TICKETS
// ============================================================

model Ticket {
  id           String   @id @default(cuid())
  orderId      String
  ticketNumber String
  content      Json
  printedAt    DateTime @default(now())
  reprintCount Int      @default(0)

  order Order @relation(fields: [orderId], references: [id])

  @@map("tickets")
}

// ============================================================
// INVENTORY & STOCK
// ============================================================

model Ingredient {
  id          String  @id @default(cuid())
  name        String
  unit        String
  costPerUnit Decimal? @db.Decimal(10, 4)
  isActive    Boolean  @default(true)

  recipeItems        RecipeItem[]
  stockItems         StockItem[]
  wasteRecords       WasteRecord[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("ingredients")
}

model RecipeItem {
  id           String  @id @default(cuid())
  productId    String
  ingredientId String
  quantity     Decimal @db.Decimal(10, 4)

  product    Product    @relation(fields: [productId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId])
  @@map("recipe_items")
}

model StockItem {
  id              String    @id @default(cuid())
  branchId        String
  ingredientId    String
  currentStock    Decimal   @db.Decimal(10, 4)
  minStock        Decimal   @db.Decimal(10, 4) @default(0)
  maxStock        Decimal?  @db.Decimal(10, 4)
  lastRestockedAt DateTime?
  updatedAt       DateTime  @updatedAt

  branch     Branch     @relation(fields: [branchId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([branchId, ingredientId])
  @@map("stock_items")
}

model WasteRecord {
  id           String   @id @default(cuid())
  ingredientId String
  branchId     String
  quantity     Decimal  @db.Decimal(10, 4)
  reason       String
  recordedBy   String
  recordedAt   DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("waste_records")
}

// ============================================================
// SUPPLIERS & PURCHASES
// ============================================================

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  taxId       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  branches       SupplierBranch[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model SupplierBranch {
  supplierId String
  branchId   String

  supplier Supplier @relation(fields: [supplierId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@id([supplierId, branchId])
  @@map("supplier_branches")
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  supplierId   String
  branchId     String
  orderNumber  String
  status       String    @default("draft")
  subtotal     Decimal   @db.Decimal(10, 2) @default(0)
  taxAmount    Decimal   @db.Decimal(10, 2) @default(0)
  total        Decimal   @db.Decimal(10, 2) @default(0)
  notes        String?
  expectedDate DateTime?
  receivedDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  payables AccountPayable[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  ingredientId    String
  quantity        Decimal  @db.Decimal(10, 4)
  unitPrice       Decimal  @db.Decimal(10, 4)
  receivedQty     Decimal? @db.Decimal(10, 4)
  subtotal        Decimal  @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])

  @@map("purchase_order_items")
}

model AccountPayable {
  id              String    @id @default(cuid())
  purchaseOrderId String
  amount          Decimal   @db.Decimal(10, 2)
  paidAmount      Decimal   @db.Decimal(10, 2) @default(0)
  dueDate         DateTime
  paidDate        DateTime?
  status          String    @default("pending")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@map("accounts_payable")
}

// ============================================================
// CRM / CLIENTS
// ============================================================

model Client {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String?
  email         String?   @unique
  phone         String?   @unique
  address       String?
  birthday      DateTime?
  loyaltyPoints Int       @default(0)
  totalSpent    Decimal   @db.Decimal(10, 2) @default(0)
  visitCount    Int       @default(0)
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders         Order[]
  loyaltyHistory LoyaltyHistory[]

  @@map("clients")
}

model LoyaltyHistory {
  id        String   @id @default(cuid())
  clientId  String
  points    Int
  reason    String
  orderId   String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@map("loyalty_history")
}

// ============================================================
// PROMOTIONS
// ============================================================

model Promotion {
  id            String    @id @default(cuid())
  name          String
  description   String?
  type          String
  discountValue Decimal?  @db.Decimal(10, 2)
  conditions    Json?
  startDate     DateTime?
  endDate       DateTime?
  startTime     String?
  endTime       String?
  daysOfWeek    Int[]
  isAutomatic   Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  branches PromotionBranch[]
  orders   Order[]

  @@map("promotions")
}

model PromotionBranch {
  promotionId String
  branchId    String

  promotion Promotion @relation(fields: [promotionId], references: [id])
  branch    Branch    @relation(fields: [branchId], references: [id])

  @@id([promotionId, branchId])
  @@map("promotion_branches")
}

// ============================================================
// DELIVERY
// ============================================================

model Delivery {
  id              String    @id @default(cuid())
  orderId         String    @unique
  driverId        String?
  customerName    String
  customerPhone   String
  deliveryAddress String
  latitude        Float?
  longitude       Float?
  status          String    @default("pending")
  estimatedTime   Int?
  deliveryFee     Decimal   @db.Decimal(10, 2) @default(0)
  assignedAt      DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  notes           String?

  order  Order @relation(fields: [orderId], references: [id])
  driver User? @relation("driver", fields: [driverId], references: [id])

  @@map("deliveries")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
